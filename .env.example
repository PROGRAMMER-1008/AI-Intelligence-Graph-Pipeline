# Copy this file to .env and fill in the values you have.
# Only GROQ_API_KEY is required to run the LLM extraction tier for
# this deployment. GEMINI_API_KEY and DEEPSEEK_API_KEY are optional —
# the orchestrator automatically skips any tier whose key is absent
# (see src/llm/orchestrator.py). GITHUB_TOKEN is optional but strongly
# recommended: without it, GitHub API calls are capped at 60/hour
# (shared across your IP), which will get exhausted almost
# immediately when fetching star counts for 1000+ research papers.

GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Personal access token, no special scopes needed (public repo read
# only). Create one at https://github.com/settings/tokens
# Raises the GitHub REST API rate limit from 60/hour to 5000/hour.
GITHUB_TOKEN=
